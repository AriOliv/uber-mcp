# ─── HTTP / OAuth server ────────────────────────────────────────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000
# HS256 signing key for MCP JWTs — generate with: openssl rand -hex 32
MCP_JWT_SECRET=

# ─── Remote browser (server-side Chromium for Uber login) ──────────────────
# Max concurrent browser login sessions
MAX_BROWSER_SESSIONS=3
# Set to "false" to launch headed Chrome (useful for local debugging)
BROWSER_HEADLESS=true

# ─── stdio mode / dev fallback ─────────────────────────────────────────────
# Populate after one successful HTTP login. Read from /debug/users in dev mode
# or copy from server logs.
UBER_COOKIE_HEADER=
UBER_CITY_ID=458
UBER_SESSION_TYPE=desktop_session
UBER_USER_SUB=
